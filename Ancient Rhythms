#Ancient Rhythms

use_bpm 140

live_loop :drums do
  sample :drum_bass_hard
  sleep 1
  sample :drum_heavy_kick
  sleep 0.5
  sample :drum_cymbal_closed
  sleep 0.5
  sample :drum_tom_hi_soft
  sleep 1
end

live_loop :lead do
  use_synth :pluck
  sync :drums
  play 64, release: 0.8, amp: 1.5
  sleep 1
  play 67, release: 0.8, amp: 1.5
  sleep 1
  play 71, release: 1.5, amp: 1.5
  sleep 1
  
  play 69, release: 0.8, amp: 1.5
  sleep 1
  play 67, release: 0.8, amp: 1.5
  sleep 1
  play 64, release: 1.5, amp: 1.5
  sleep 1
end

live_loop :bass do
  use_synth :fm
  sync :drums
  
  play 40, release: 0.4, amp: 1.2
  sleep 0.5
  play 40, release: 0.4, amp: 1.2
  sleep 0.5
  play 40, release: 0.4, amp: 1.2
  sleep 1
end

live_loop :variation do
  use_synth :dpulse
  sync :lead
  
  sleep 2
  
  play 76, release: 0.15, amp: 0.5
  sleep 0.25
  play 79, release: 0.15, amp: 0.5
  sleep 0.25
  play 81, release: 0.3, amp: 0.6
  sleep 0.5
end
